# Local secrets — never commit real values
# Copy to apps/api/.env (Prisma + API load from there)

DATABASE_URL=postgresql://email:email@localhost:5433/email_templates

# REQUIRED for local Phase 1: must be set explicitly to "dev" or "erp"
# Unset / other values → API returns 401 (fail-closed)
AUTH_MODE=dev

# When AUTH_MODE=erp: HS256 Bearer JWT (claims: sub, permissions|Authorized_Works)
# ERP_JWT_SECRET=

API_PORT=3001
# Loopback only — DevAuth refuses non-loopback unless ALLOW_INSECURE_DEV=1
API_HOST=127.0.0.1
EDITOR_ORIGIN=http://localhost:5173
# Optional extra CORS origins (comma-separated) for Origin CSRF check
# CORS_ADDITIONAL_ORIGINS=

# ALLOW_INSECURE_DEV=1

# Brevo — backend secret only (never VITE_*)
# Set in apps/api/.env, then restart API. List sync: POST /api/templates/sync-brevo
# Publish: POST /api/templates/:id/publish (needs sender email below)
BREVO_API_KEY=

# Compose /email-editor raw send + template publish (transactional)
# Must be a verified Brevo sender (server-side allowlist)
BREVO_DEFAULT_SENDER_EMAIL=
BREVO_DEFAULT_SENDER_NAME=halteverbot123
