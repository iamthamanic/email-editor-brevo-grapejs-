# Local secrets — never commit real values
# Copy to apps/api/.env (Prisma + API load from there)

DATABASE_URL=postgresql://email:email@localhost:5433/email_templates

# REQUIRED for local Phase 1: must be set explicitly to "dev"
# Unset / other values → API returns 401 (fail-closed)
AUTH_MODE=dev

API_PORT=3001
# Loopback only — DevAuth refuses non-loopback unless ALLOW_INSECURE_DEV=1
API_HOST=127.0.0.1
EDITOR_ORIGIN=http://localhost:5173

# ALLOW_INSECURE_DEV=1

# Brevo — backend secret only (never VITE_*)
# Set in apps/api/.env, then restart API. List sync: POST /api/templates/sync-brevo
BREVO_API_KEY=
